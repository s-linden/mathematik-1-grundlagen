import numpy as np
import plotly.graph_objects as go

s_km = np.array([1.1, 2.1, 3.1, 4.2, 5.2, 6.3, 7.3, 8.4, 9.4, 10.5, 11.5,
                12.6, 13.6, 14.7, 15.7, 16.8, 17.8, 18.9, 20.0, 21.0, 22.1,
                23.1, 24.2, 25.3, 26.4, 27.6, 28.7, 29.8, 30.9, 32.0, 33.2,
                34.3, 35.4, 36.5, 37.7, 38.8, 39.9, 41.1, 42.2, 43.3, 44.4,
                45.5, 46.6, 47.7, 48.8, 49.8, 50.8, 51.8, 52.8, 53.8, 54.8,
                55.9, 57.0, 58.1, 59.2, 60.2, 61.3, 62.4, 63.5, 64.6, 65.6])
t = np.linspace(10, 40, len(s_km))

fig = go.Figure()
fig.add_trace(go.Scatter(
    x=t,
    y=s_km,
    mode='markers',
    name='Fahrtenschreiber'
))
fig.update_layout(
    xaxis_title='Zeit [min]',
    yaxis_title='Strecke seit Autobahnauffahrt [km]',
    title='Protokoll des Fahrtenschreibers'
)
# Erstelle die Figur als interaktives html
fig.write_html("plots/fahrtenschreiber.html")           
